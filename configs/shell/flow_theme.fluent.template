<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Komoyasb Unified Fluent Theme for Flow Launcher -->
    <!-- Generated dynamically from {{name}} ({{variant}}) -->

    <!-- Geometry & Sizing -->
    <CornerRadius x:Key="WindowCornerRadius">{{geometry.border_radius}}</CornerRadius>
    <CornerRadius x:Key="SearchBoxCornerRadius">{{geometry.border_radius}}</CornerRadius>
    <CornerRadius x:Key="ItemCornerRadius">{{geometry.border_radius}}</CornerRadius>
    <Thickness x:Key="WindowBorderThickness">{{geometry.border_width}}</Thickness>

    <!-- Base Solid Colors -->
    <Color x:Key="ColorPrimaryBackground">{{colors.bg_primary}}</Color>
    <Color x:Key="ColorSecondaryBackground">{{colors.bg_secondary}}</Color>
    <Color x:Key="ColorSurface">{{colors.bg_surface}}</Color>
    <Color x:Key="ColorPrimaryForeground">{{colors.fg_primary}}</Color>
    <Color x:Key="ColorSecondaryForeground">{{colors.fg_secondary}}</Color>
    <Color x:Key="ColorMutedForeground">{{colors.fg_muted}}</Color>
    <Color x:Key="ColorAccent">{{colors.accent}}</Color>
    <Color x:Key="ColorAccentSecondary">{{colors.accent_secondary}}</Color>
    <Color x:Key="ColorBorderActive">{{colors.border_active}}</Color>
    <Color x:Key="ColorBorderInactive">{{colors.border_inactive}}</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource ColorPrimaryBackground}" Opacity="{{opacity.launcher}}" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="{StaticResource ColorBorderActive}" />
    <SolidColorBrush x:Key="SearchBoxBackgroundBrush" Color="{StaticResource ColorSecondaryBackground}" Opacity="0.85" />
    <SolidColorBrush x:Key="SearchBoxTextBrush" Color="{StaticResource ColorPrimaryForeground}" />
    <SolidColorBrush x:Key="SearchBoxPlaceholderBrush" Color="{StaticResource ColorMutedForeground}" />
    
    <!-- Item Selection Brushes -->
    <SolidColorBrush x:Key="ItemNormalBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ItemMouseOverBackgroundBrush" Color="{StaticResource ColorSurface}" Opacity="0.70" />
    <SolidColorBrush x:Key="ItemSelectedBackgroundBrush" Color="{StaticResource ColorAccent}" Opacity="0.30" />
    <SolidColorBrush x:Key="ItemBorderSelectedBrush" Color="{StaticResource ColorAccent}" />
    
    <!-- Text Brushes -->
    <SolidColorBrush x:Key="ItemTitleTextBrush" Color="{StaticResource ColorPrimaryForeground}" />
    <SolidColorBrush x:Key="ItemSubtitleTextBrush" Color="{StaticResource ColorSecondaryForeground}" />
    <SolidColorBrush x:Key="ItemActionKeywordTextBrush" Color="{StaticResource ColorAccentSecondary}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{StaticResource ColorAccent}" />

    <!-- Typography -->
    <FontFamily x:Key="QueryBoxFont">{{typography.font_family}}</FontFamily>
    <FontFamily x:Key="ItemTitleFont">{{typography.font_family}}</FontFamily>
    <FontFamily x:Key="ItemSubtitleFont">{{typography.font_family}}</FontFamily>
</ResourceDictionary>
