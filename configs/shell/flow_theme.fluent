<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Komoyasb Unified Fluent Theme for Flow Launcher -->
    <!-- Generated dynamically from Tokyo Night Dark (dark) -->

    <!-- Geometry & Sizing -->
    <CornerRadius x:Key="WindowCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="SearchBoxCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ItemCornerRadius">8</CornerRadius>
    <Thickness x:Key="WindowBorderThickness">2</Thickness>

    <!-- Base Solid Colors -->
    <Color x:Key="ColorPrimaryBackground">#1a1b26</Color>
    <Color x:Key="ColorSecondaryBackground">#16161e</Color>
    <Color x:Key="ColorSurface">#24283b</Color>
    <Color x:Key="ColorPrimaryForeground">#c0caf5</Color>
    <Color x:Key="ColorSecondaryForeground">#a9b1d6</Color>
    <Color x:Key="ColorMutedForeground">#565f89</Color>
    <Color x:Key="ColorAccent">#7aa2f7</Color>
    <Color x:Key="ColorAccentSecondary">#bb9af7</Color>
    <Color x:Key="ColorBorderActive">#7aa2f7</Color>
    <Color x:Key="ColorBorderInactive">#292e42</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource ColorPrimaryBackground}" Opacity="0.92" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="{StaticResource ColorBorderActive}" />
    <SolidColorBrush x:Key="SearchBoxBackgroundBrush" Color="{StaticResource ColorSecondaryBackground}" Opacity="0.85" />
    <SolidColorBrush x:Key="SearchBoxTextBrush" Color="{StaticResource ColorPrimaryForeground}" />
    <SolidColorBrush x:Key="SearchBoxPlaceholderBrush" Color="{StaticResource ColorMutedForeground}" />
    
    <!-- Item Selection Brushes -->
    <SolidColorBrush x:Key="ItemNormalBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ItemMouseOverBackgroundBrush" Color="{StaticResource ColorSurface}" Opacity="0.70" />
    <SolidColorBrush x:Key="ItemSelectedBackgroundBrush" Color="{StaticResource ColorAccent}" Opacity="0.30" />
    <SolidColorBrush x:Key="ItemBorderSelectedBrush" Color="{StaticResource ColorAccent}" />
    
    <!-- Text Brushes -->
    <SolidColorBrush x:Key="ItemTitleTextBrush" Color="{StaticResource ColorPrimaryForeground}" />
    <SolidColorBrush x:Key="ItemSubtitleTextBrush" Color="{StaticResource ColorSecondaryForeground}" />
    <SolidColorBrush x:Key="ItemActionKeywordTextBrush" Color="{StaticResource ColorAccentSecondary}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{StaticResource ColorAccent}" />

    <!-- Typography -->
    <FontFamily x:Key="QueryBoxFont">JetBrainsMono Nerd Font</FontFamily>
    <FontFamily x:Key="ItemTitleFont">JetBrainsMono Nerd Font</FontFamily>
    <FontFamily x:Key="ItemSubtitleFont">JetBrainsMono Nerd Font</FontFamily>
</ResourceDictionary>
