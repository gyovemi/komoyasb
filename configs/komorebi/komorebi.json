{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.33/schema.json",
  "app_specific_configuration_path": "$USERPROFILE/.config/komorebi/applications.yaml",
  "cross_monitor_move_behaviour": "Insert",
  "default_workspace_padding": 8,
  "default_container_padding": 8,
  "animation": {
    "enabled": true,
    "duration": 150,
    "fps": 60,
    "style": "Linear"
  },
  "border": true,
  "border_width": 2,
  "border_offset": 0,
  "border_style": "rounded",
  "border_implementation": "Komorebi",
  "border_colours": {
    "single": "#7aa2f7",
    "stack": "#bb9af7",
    "monocle": "#7aa2f7",
    "unfocused": "#292e42",
    "floating": "#bb9af7"
  },
  "unmanaged_window_operation_behaviour": "Op",
  "mouse_follows_focus": false,
  "focus_follows_mouse": "Komorebi",
  "transparency": false,
  "transparency_alpha": 0.85,
  "window_hiding_behaviour": "Cloak",
  "workspaces_per_monitor": true,
  "monitors": [
    {
      "workspaces": [
        {
          "name": "1:dev",
          "layout": "BSP"
        },
        {
          "name": "2:web",
          "layout": "BSP"
        },
        {
          "name": "3:chat",
          "layout": "Columns"
        },
        {
          "name": "4:code",
          "layout": "BSP"
        },
        {
          "name": "5:media",
          "layout": "BSP"
        },
        {
          "name": "6:docs",
          "layout": "BSP"
        },
        {
          "name": "7:sys",
          "layout": "BSP"
        },
        {
          "name": "8:misc",
          "layout": "BSP"
        },
        {
          "name": "9:float",
          "layout": "Floating"
        }
      ]
    },
    {
      "workspaces": [
        {
          "name": "10:sec1",
          "layout": "BSP"
        },
        {
          "name": "11:sec2",
          "layout": "BSP"
        },
        {
          "name": "12:sec3",
          "layout": "Columns"
        },
        {
          "name": "13:sec4",
          "layout": "BSP"
        }
      ]
    }
  ],
