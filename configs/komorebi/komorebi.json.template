        {
          "name": "7:sys",
          "layout": "BSP"
        },
        {
          "name": "8:misc",
          "layout": "BSP"
        },
        {
          "name": "9:float",
          "layout": "Floating"
        }
      ]
    },
    {
      "workspaces": [
        {
          "name": "10:sec1",
          "layout": "BSP"
        },
        {
          "name": "11:sec2",
          "layout": "BSP"
