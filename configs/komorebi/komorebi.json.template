{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.33/schema.json",
  "app_specific_configuration_path": "$USERPROFILE/.config/komorebi/applications.yaml",
  "cross_monitor_move_behaviour": "Insert",
  "default_workspace_padding": {{geometry.window_gap}},
  "default_container_padding": {{geometry.window_gap}},
  "animation": {
    "enabled": {{perf.komorebi.animation_enabled}},
    "duration": {{perf.komorebi.animation_duration_ms}},
    "fps": {{perf.komorebi.animation_fps}},
    "style": "Linear"
  },
  "border": {{perf.komorebi.border_enabled}},
  "border_width": {{perf.komorebi.border_width}},
  "border_offset": {{perf.komorebi.border_offset}},
  "border_style": "{{perf.komorebi.border_style}}",
  "border_implementation": "{{perf.komorebi.border_implementation}}",
  "border_colours": {
    "single": "{{colors.border_active}}",
    "stack": "{{colors.accent_secondary}}",
    "monocle": "{{colors.accent}}",
    "unfocused": "{{colors.border_inactive}}",
    "floating": "{{colors.accent_secondary}}"
  },
  "unmanaged_window_operation_behaviour": "{{perf.komorebi.unmanaged_window_operation_behaviour}}",
  "mouse_follows_focus": false,
  "focus_follows_mouse": "Komorebi",
  "transparency": {{perf.komorebi.transparency_enabled}},
  "transparency_alpha": {{opacity.window_unfocused}},
  "window_hiding_behaviour": "{{perf.komorebi.window_hiding_behaviour}}",
  "workspaces_per_monitor": true,
  "monitors": [
    {
      "workspaces": [
        {
          "name": "1:dev",
          "layout": "BSP"
        },
        {
          "name": "2:web",
          "layout": "BSP"
        },
        {
          "name": "3:chat",
          "layout": "Columns"
        },
        {
          "name": "4:code",
