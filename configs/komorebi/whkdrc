# .whkdrc - Windows Hotkey Daemon Configuration Template
# Ergonomic vim-like bindings for Komorebi tiling window manager
# Processed dynamically via scripts/sync-theme.ps1
#
# Reload Instructions:
#   Reload daemon configuration via shortcut (Alt + Shift + R) or run:
#   komorebic reload-configuration; whkd --reload

# Focus & Window Navigation (Vim-style: H/J/K/L)
# Focus neighboring window in direction
alt + h : komorebic focus left
alt + j : komorebic focus down
alt + k : komorebic focus up
alt + l : komorebic focus right

# Move / Swap Windows within Container & Tree
alt + shift + h : komorebic move left
alt + shift + j : komorebic move down
alt + shift + k : komorebic move up
alt + shift + l : komorebic move right

# Resize Focused Window Axis
alt + ctrl + h : komorebic resize-axis horizontal decrease
alt + ctrl + l : komorebic resize-axis horizontal increase
alt + ctrl + j : komorebic resize-axis vertical decrease
alt + ctrl + k : komorebic resize-axis vertical increase

# Workspace Management (1-9)
# Switch Focus to Workspace (0-indexed komorebi targets)
alt + 1 : komorebic focus-workspace 0
alt + 2 : komorebic focus-workspace 1
alt + 3 : komorebic focus-workspace 2
alt + 4 : komorebic focus-workspace 3
alt + 5 : komorebic focus-workspace 4
alt + 6 : komorebic focus-workspace 5
alt + 7 : komorebic focus-workspace 6
alt + 8 : komorebic focus-workspace 7
alt + 9 : komorebic focus-workspace 8

# Move Active Window to Target Workspace (0-indexed)
alt + shift + 1 : komorebic move-to-workspace 0
alt + shift + 2 : komorebic move-to-workspace 1
alt + shift + 3 : komorebic move-to-workspace 2
alt + shift + 4 : komorebic move-to-workspace 3
alt + shift + 5 : komorebic move-to-workspace 4
alt + shift + 6 : komorebic move-to-workspace 5
alt + shift + 7 : komorebic move-to-workspace 6
alt + shift + 8 : komorebic move-to-workspace 7
alt + shift + 9 : komorebic move-to-workspace 8

# Cycle Workspaces Sequentially
alt + bracketleft  : komorebic cycle-workspace previous
alt + bracketright : komorebic cycle-workspace next

# Multi-Monitor Navigation
# Cycle focus to next connected monitor
alt + o : komorebic cycle-monitor next
# Move active window to next connected monitor
alt + shift + o : komorebic move-to-monitor next

# Window States & Layouts
# Toggle Floating / Tiling State for active window
alt + f : komorebic toggle-float

# Toggle Monocle / Fullscreen
alt + m : komorebic toggle-monocle

# Toggle Window Maximization
alt + shift + m : komorebic toggle-maximize

# Change Layout Algorithm (BSP, Columns, Rows, Grid)
alt + b : komorebic toggle-bsp
alt + c : komorebic change-layout columns
alt + r : komorebic change-layout rows
alt + g : komorebic change-layout grid

# Flip / Rotate Layout Axes
alt + x : komorebic flip-layout horizontal
alt + y : komorebic flip-layout vertical

# Promote window to master container
alt + enter : komorebic promote

# Close active window
alt + q : komorebic close

# Minimize active window
alt + n : komorebic minimize

# Stacking Containers
# Toggle container stacking
alt + s : komorebic toggle-stack
# Cycle stacked container forward
alt + semicolon : komorebic cycle-stack next
# Cycle stacked container backward
alt + comma : komorebic cycle-stack previous

# Tiling Manager Controls & Lifecycle
# Toggle Tiling (pause/resume komorebi)
alt + p : komorebic toggle-pause

# Reload Komorebi & WHKD Configurations
alt + shift + r : komorebic reload-configuration; whkd --reload

# Restart Komorebi Daemon
alt + ctrl + r : komorebic stop; komorebic start --whkd

# Quick Application Launchers
# Launch Windows Terminal
alt + shift + enter : wt.exe
# Launch Windows File Explorer
alt + e : explorer.exe
